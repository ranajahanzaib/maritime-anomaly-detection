# Vessel Behavior Analysis Configuration
PROJECT_NAME=Vessel Behavior Analysis
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# Database (Default uses SQLite for zero-config local run, can be pointed to Postgres/PostGIS)
DATABASE_URL=sqlite:///./data/vessel_behavior.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vessel_behavior

# Storage Paths
STORAGE_DIR=./data/storage
MODELS_DIR=./data/models
DEMO_DATA_DIR=./data/demo

# Processing Settings
MAX_TIME_GAP_MINUTES=45
MIN_OBSERVATIONS_PER_TRAJECTORY=5
SIMPLIFICATION_TOLERANCE_DEG=0.0005
MAX_PLAUSIBLE_SPEED_KNOTS=55.0
MAX_PLAUSIBLE_ACCELERATION_MS2=4.0

# Worker Settings
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2
